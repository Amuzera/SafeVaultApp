{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "SafeVault",
    "Audience": "SafeVaultUsers",
    "Key": "YOUR_JWT_SECRET_KEY_HERE",
    "AccessTokenExpirationTimeInMinutes": 60,
    "RefreshTokenExpirationTimeDays": 7
  },
  "ConnectionStrings": {
    "DefaultConnection": "server=localhost;database=SafeVault;user=root;password=YOUR_DATABASE_PASSWORD;"
  }
}
